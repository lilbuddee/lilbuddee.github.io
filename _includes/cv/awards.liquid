{% comment %}
  Unified awards entry renderer for both formats

  Local override of al_folio_cv's awards.liquid:
  - Renders entries as <div>s instead of <ul><li> so no bullet marker is shown (this site runs
    Tailwind with preflight disabled and Bootstrap compat off, so the gem's list-group
    bullet-suppression CSS isn't reliably available).
  - Puts the date badge inline next to the title instead of in a fixed-width side column; the
    side-column layout (transform nudge) overflowed into the title text at common viewport widths.
{% endcomment %}

<div class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <div class="list-group-item">
      {% capture start_date %}
        {% if entry.date %}{{ entry.date }}{% endif %}
      {% endcapture %}
      {% assign award_year = start_date | split: '-' | slice: 0, 1 | join: '' %}

      <div class="d-flex justify-content-between align-items-baseline flex-wrap" style="gap: 0.5rem">
        {% if entry.url %}
          <h6 class="title font-weight-bold mb-0">
            <a href="{{ entry.url }}">{{ entry.title }}</a>
          </h6>
        {% elsif entry.title %}
          <h6 class="title font-weight-bold mb-0">{{ entry.title }}</h6>
        {% endif %}
        {% if award_year != '' %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="white-space: nowrap; flex-shrink: 0">{{ award_year }}</span>
        {% endif %}
      </div>

      {% if entry.awarder %}
        <h6 class="mb-0" style="font-size: 0.95rem">{{ entry.awarder }}</h6>
      {% endif %}

      {% if entry.summary %}
        <p class="mb-0">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
      {% endif %}
    </div>
  {% endfor %}
</div>
