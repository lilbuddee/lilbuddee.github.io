{% comment %}
  Unified publications entry renderer for both formats

  Local override of al_folio_cv's publications.liquid:
  - Renders entries as <div>s instead of <ul><li> so no bullet marker is shown (this site runs
    Tailwind with preflight disabled and Bootstrap compat off, so the gem's list-group
    bullet-suppression CSS isn't reliably available).
  - Puts the date badge inline next to the title instead of in a fixed-width side column; the
    side-column layout (transform nudge) overflowed into the title text at common viewport widths.
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div
      class="list-group-item"
      {% unless forloop.first %}
        style="margin-top: 1rem"
      {% endunless %}
    >
      {% capture pub_date %}
        {% if entry.releaseDate %}{{ entry.releaseDate }}{% elsif entry.date %}{{ entry.date }}{% endif %}
      {% endcapture %}
      {% assign pub_date = pub_date | strip %}
      {% comment %} Show "Mon YYYY" when a month is present (e.g. "2026-05"), otherwise just the year. {% endcomment %}
      {% if pub_date contains '-' %}
        {% assign pub_date_display = pub_date | append: '-01' | date: '%b %Y' %}
      {% else %}
        {% assign pub_date_display = pub_date %}
      {% endif %}

      {% comment %}
        Numbered subsections (Refereed Journals, Review, Preparation, Ph.D.
        Thesis, Snowmass2021, Muon g-2) get a raw-Typst spacer box + gap and
        a matching hanging-indent prefixed onto the title so single- and
        double-digit numbers right-align on the PDF and wrapped 2nd lines
        align with the title text - see format_number_prefix() in
        make_publications.py. That markup means nothing to a browser, so
        strip it here before display.
      {% endcomment %}
      {% assign display_title = entry.title
        | default: entry.name
        | regex_replace: '#set par\(hanging-indent: [\d.]+em\);', ''
        | regex_replace: '#box\(width: [\d.]+em\)\[\]', ''
        | regex_replace: '#h\([\d.]+em\)', ' '
      %}
      <div class="d-flex" style="gap: 0.5rem; align-items: flex-start">
        {% if entry.url %}
          <h6 class="title font-weight-bold mb-0" style="flex: 1 1 auto; min-width: 0">
            <a href="{{ entry.url }}">{{ display_title }}</a>
          </h6>
        {% elsif entry.title %}
          <h6 class="title font-weight-bold mb-0" style="flex: 1 1 auto; min-width: 0">{{ display_title }}</h6>
        {% endif %}
        {% if pub_date != '' %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="white-space: nowrap; flex: 0 0 auto">
            {{- pub_date_display -}}
          </span>
        {% endif %}
      </div>

      {% if entry.journal %}
        <h6 class="mb-0" style="font-size: 0.95rem">
          <em>{{ entry.journal }}</em>
        </h6>
      {% endif %}

      {% if entry.summary %}
        <p class="mb-0">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
      {% endif %}
    </div>
  {% endfor %}
</div>
